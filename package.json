{
  "name": "advisory-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint && node scripts/check-design-tokens.mjs && node scripts/check-a11y-render.mjs",
    "test": "pnpm test:unit:coverage && pnpm test:e2e",
    "test:unit": "vitest run",
    "test:unit:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:auth": "playwright test",
    "lint:tokens": "node scripts/check-design-tokens.mjs",
    "lint:a11y": "node scripts/check-a11y-render.mjs",
    "preview": "next build && wrangler dev",
    "deploy": "next build && wrangler deploy",
    "cf-typegen": "wrangler types --env-interface CloudcflareEnv cloudflare-env.d.ts",
    "test:ui:coverage": "node scripts/run-ui-coverage.mjs",
    "test:ui:coverage:report": "node scripts/report-ui-coverage.mjs --check"
  },
  "devDependencies": {
    "@bcoe/v8-coverage": "1.0.2",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/noto-sans-thai": "^5.3.0",
    "@jridgewell/trace-mapping": "0.3.31",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitest/coverage-v8": "^3.2.7",
    "ast-v8-to-istanbul": "0.3.12",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.0",
    "istanbul-lib-coverage": "3.2.2",
    "istanbul-lib-report": "3.0.1",
    "istanbul-reports": "3.2.0",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7",
    "wrangler": "^4.119.0"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@fontsource/kanit": "^5.3.0",
    "@fontsource/prompt": "^5.3.0",
    "@fontsource/sriracha": "^5.3.0",
    "@gsap/react": "^2.1.2",
    "@hookform/resolvers": "^5.9.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gsap": "^3.15.0",
    "hls.js": "^1.7.0",
    "lenis": "^1.3.27",
    "lucide-react": "^1.29.0",
    "next": "^16.3.0",
    "next-intl": "^4.13.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.88.0",
    "shadcn": "^4.16.2",
    "socket.io-client": "^4.8.4",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  }
}
