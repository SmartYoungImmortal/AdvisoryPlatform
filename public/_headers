# Cache policy for the Cloudflare static-asset deploy. Next copies public/ into
# out/, and Cloudflare reads out/_headers from there.
#
# Workers Assets serves everything as `public, max-age=0, must-revalidate` by
# default, so a browser revalidates all ~16 build files referenced by a page on
# every navigation. The filenames under /_next/static/ already carry a content
# hash — a changed file gets a new name — so they can safely be cached forever
# and never revalidated.
#
# HTML is deliberately left on the default: it keeps the unhashed URLs, so it
# must stay revalidated for a deploy to go live immediately.

/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# The service worker behind device notifications (public/sw.js). The browser
# re-checks it for a new version on every load; a cached copy would pin people
# to an old one, so it is never cached.
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate
  Content-Type: application/javascript; charset=utf-8

# --- Level 2, not built yet: offline support -------------------------------
#
# The app is installable today (app/manifest.ts) but has no service worker, so
# it still needs the network. When one lands, its headers belong here rather
# than in `next.config.ts`: `headers()` does nothing under `output: "export"`,
# which is why every cache rule in this file lives in the proxy instead.
#
# A service worker must never be cached — the browser checks it for a new build
# on every load, and a stale copy pins users to an old app indefinitely:
#
#   /sw.js
#     Cache-Control: no-cache, no-store, must-revalidate
#     Content-Type: application/javascript; charset=utf-8
#
# Next's own guide points at Serwist for the worker itself. This app is a good
# candidate — every route is prerendered and every record is a fixture, so
# there is nothing dynamic to miss offline.
#
# Push notifications are built (public/sw.js, lib/push/, the API's
# /notifications/push endpoints); only offline caching is left for this level.
