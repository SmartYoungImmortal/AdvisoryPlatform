{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "advisory-platform",
  "compatibility_date": "2025-03-25",
  "compatibility_flags": [
    // Enable Node.js APIs on Workers
    "nodejs_compat",
    // Allow fetching public URLs from your app
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  }
  // Add bindings here as the app grows (D1/KV/R2/Durable Objects, env vars, etc.)
}
