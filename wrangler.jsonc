{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "advisory-platform",
  "compatibility_date": "2025-03-25",

  // No "main": the site is a Next static export, so Cloudflare serves it from
  // the assets store directly. Requests never invoke a Worker, which keeps the
  // Free plan's 10ms CPU limit out of the picture entirely (static asset
  // requests are unmetered). Add "main" back if a Worker becomes necessary.
  "assets": {
    "directory": "out",
    // `/login` resolves to `out/login.html`.
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },

  // Environments: `main` deploys prod (top-level), `dev` deploys qa (env.qa)
  "env": {
    "qa": {
      "name": "advisory-platform-qa",
      "assets": {
        "directory": "out",
        "html_handling": "auto-trailing-slash",
        "not_found_handling": "404-page"
      }
    }
  }
}
